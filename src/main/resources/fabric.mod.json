{
	"schemaVersion": 1,
	"id": "elites-mod",
	"version": "${version}",
	"name": "Elite's Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/elites-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"elite.mod.EliteSMod"
		],
		"client": [
			"elite.mod.client.EliteSModClient"
		],
		"modmenu": [
			"elite.mod.client.EliteSModMenu"
		],
		"fabric-datagen": [
			"elite.mod.client.EliteSModDataGenerator"
		]
	},
	"mixins": [
		"elites-mod.mixins.json",
		{
			"config": "elites-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}