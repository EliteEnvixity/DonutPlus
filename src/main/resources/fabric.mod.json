{
	"schemaVersion": 1,
	"id": "donutplus",
	"version": "${version}",
	"name": "DonutPLUS",
	"description": "Technical features and quality-of-life improvements designed specifically for DonutSMP.",
	"authors": [
		"EliteEnvixity"
	],
	"contact": {
		"homepage": "https://github.com/EliteEnvixity/DonutPlus",
		"sources": "https://github.com/EliteEnvixity/DonutPlus",
		"issues": "https://github.com/EliteEnvixity/DonutPlus/issues"
	},
	"license": "LicenseRef-DonutPLUS-1.0",
	"icon": "assets/donutplus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"elite.mod.DonutPlus"
		],
		"client": [
			"elite.mod.client.DonutPlusClient"
		],
		"modmenu": [
			"elite.mod.client.DonutPlusMenu"
		],
		"fabric-datagen": [
			"elite.mod.client.DonutPlusDataGenerator"
		]
	},
	"mixins": [
		"donutplus.mixins.json",
		{
			"config": "donutplus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
